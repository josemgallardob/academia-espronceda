# Copy this file to .env.local. The values below are local-only and are not secrets.
NODE_ENV=development

WEB_HOST=127.0.0.1
WEB_PORT=4200

API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

SOLVER_HOST=127.0.0.1
SOLVER_PORT=8001
SOLVER_URL=http://127.0.0.1:8001

DATABASE_URL=file:./.data/academia-espronceda.db
DATABASE_AUTH_TOKEN=

# Deliberately public development placeholders. Never use them outside local development.
JWT_SECRET=local-only-jwt-secret-replace-in-every-deployed-environment
JWT_ISSUER=academia-espronceda-api
JWT_AUDIENCE=academia-espronceda-web
JWT_TTL_SECONDS=36000
INTERNAL_SERVICE_TOKEN=local-only-service-token-replace-in-every-deployed-environment

AUTH_COOKIE_NAME=academia_session
XSRF_COOKIE_NAME=XSRF-TOKEN
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IDENTIFIER_LIMIT=5
COOKIE_SECURE=false
TRUST_PROXY=false

# Local-only administrative demo accounts created by `npm run seed:local`.
# These placeholders are not secrets and must never be used outside development.
LOCAL_DEMO_USERNAME_1=profesor1
LOCAL_DEMO_PASSWORD_1=local-only-admin-password-1
LOCAL_DEMO_USERNAME_2=profesor2
LOCAL_DEMO_PASSWORD_2=local-only-admin-password-2

# Optional teacher labels used by `npm run seed:local` and `npm run seed:teachers`.
# Keep generic values in this example. Real names belong only in `.env.local`.
TEACHER_1_DISPLAY_NAME=Profesor 1
TEACHER_2_DISPLAY_NAME=Profesor 2
TEACHER_3_DISPLAY_NAME=Profesor 3
