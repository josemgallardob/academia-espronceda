# Copy this file to .env.local. The values below are local-only and are not secrets.
NODE_ENV=development

WEB_HOST=127.0.0.1
WEB_PORT=4200

API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

SOLVER_HOST=127.0.0.1
SOLVER_PORT=8001
SOLVER_URL=http://127.0.0.1:8001

DATABASE_URL=file:./.data/academia-espronceda.db
DATABASE_AUTH_TOKEN=

# Deliberately public development placeholders. Never use them outside local development.
JWT_SECRET=local-only-jwt-secret-replace-in-every-deployed-environment
INTERNAL_SERVICE_TOKEN=local-only-service-token-replace-in-every-deployed-environment

AUTH_COOKIE_NAME=academia_session
COOKIE_SECURE=false
TRUST_PROXY=false
