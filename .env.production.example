# Variable names only: replace every <...> value in the deployment secret manager.
NODE_ENV=production

API_HOST=0.0.0.0
API_PORT=3000
API_CORS_ORIGINS=https://<public-domain>

SOLVER_HOST=0.0.0.0
SOLVER_PORT=8001
SOLVER_URL=http://academia-espronceda-solver:8001
SOLVER_TIMEOUT_BUFFER_SECONDS=5
SOLVER_MAX_CONCURRENT=1

DATABASE_URL=libsql://<database-name>-<organization>.turso.io
DATABASE_AUTH_TOKEN=<turso-auth-token>
JWT_SECRET=<at-least-64-random-characters>
JWT_ISSUER=academia-espronceda-api
JWT_AUDIENCE=academia-espronceda-web
JWT_TTL_SECONDS=36000
INTERNAL_SERVICE_TOKEN=<at-least-32-random-characters>

AUTH_COOKIE_NAME=__Host-academia_session
XSRF_COOKIE_NAME=XSRF-TOKEN
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IDENTIFIER_LIMIT=5
COOKIE_SECURE=true
TRUST_PROXY=true

# Optional visible labels for `npm run seed:teachers`. Use generic placeholders here.
TEACHER_1_DISPLAY_NAME=<teacher-1-display-name>
TEACHER_2_DISPLAY_NAME=<teacher-2-display-name>
TEACHER_3_DISPLAY_NAME=<teacher-3-display-name>
