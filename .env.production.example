# Variable names only: replace every <...> value in the deployment secret manager.
NODE_ENV=production

API_HOST=0.0.0.0
API_PORT=3000
API_CORS_ORIGINS=https://<public-domain>

SOLVER_HOST=0.0.0.0
SOLVER_PORT=8001
SOLVER_URL=http://<private-solver-host>:8001

DATABASE_URL=libsql://<database-name>-<organization>.turso.io
DATABASE_AUTH_TOKEN=<turso-auth-token>
JWT_SECRET=<at-least-64-random-characters>
INTERNAL_SERVICE_TOKEN=<at-least-32-random-characters>

AUTH_COOKIE_NAME=__Host-academia_session
COOKIE_SECURE=true
TRUST_PROXY=true
