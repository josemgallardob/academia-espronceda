{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academia-espronceda.local/contracts/rules/catalog.schema.json",
  "title": "Scheduling rule catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "name", "description", "scoring", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "comparison", "bestScore", "priorityOrder"],
      "properties": {
        "direction": {
          "const": "MINIMIZE"
        },
        "comparison": {
          "const": "LEXICOGRAPHIC"
        },
        "bestScore": {
          "const": 0
        },
        "priorityOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["priority", "name", "ruleIds"],
            "properties": {
              "priority": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "ruleIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/ruleId"
                }
              }
            }
          }
        }
      }
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "classification",
        "enforcement",
        "severity",
        "priority",
        "condition",
        "entities",
        "evidence",
        "appliesTo",
        "parameters",
        "optimization"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ruleId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": ["RULE", "PREFERENCE"]
        },
        "enforcement": {
          "enum": ["HARD", "RELAXABLE", "PREFERENCE"]
        },
        "severity": {
          "enum": ["ERROR", "WARNING", "INFO"]
        },
        "priority": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SCHEDULE",
              "CLASS",
              "ASSIGNMENT",
              "STUDENT",
              "TEACHER",
              "SUBJECT",
              "COURSE",
              "SLOT",
              "RELATIONSHIP"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SOLVER_STRICT",
              "SOLVER_RELAXED",
              "DRAFT_VALIDATION",
              "CONFIRMATION",
              "GENERATED_SCHEDULE_VALIDATION"
            ]
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        },
        "optimization": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "parameters"],
              "properties": {
                "metric": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": ["string", "number", "integer", "boolean"]
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
